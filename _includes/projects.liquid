<div class="col">
  <div class="card h-100 hoverable project-card">
    <a class="project-card-main" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% if project.img %}
        <div class="project-card-media">
          {% assign image_alt = project.title | append: ' project preview' %}
          {%
            include figure.liquid
            loading="lazy"
            path=project.img
            sizes = "(min-width: 992px) 30vw, (min-width: 768px) 45vw, 100vw"
            alt=image_alt
            class="card-img-top project-card-image"
          %}
        </div>
      {% endif %}
      <div class="card-body">
        {% if project.tags %}
          <div class="project-labels" aria-label="Project topics">
            {% for tag in project.tags %}
              <span class="project-label">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.highlight %}
          <p class="project-highlight">{{ project.highlight }}</p>
        {% endif %}
      </div>
    </a>
    {% if project.github %}
      <div class="project-card-footer">
        <a class="project-code-link" href="{{ project.github }}" aria-label="{{ project.title }} code repository">
          <i class="fa-brands fa-github gh-icon" aria-hidden="true"></i>
          <span>Code</span>
        </a>
        {% if project.github_stars %}
          <span class="stars" data-toggle="tooltip" title="GitHub Stars">
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <span id="{{ project.github_stars }}-stars"></span>
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
